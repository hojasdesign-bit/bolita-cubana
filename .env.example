# ── Bolita Crypto · variables de entorno ─────────────────────────────
# Copia este archivo a `.env` y completa los valores.

# Dirección de tesorería de la banca (TU dirección en Base Sepolia).
# Los depósitos de testnet de los jugadores van a esta dirección.
# Sin este valor la app usa una dirección de ejemplo y avisa en la UI.
VITE_TREASURY_ADDRESS=

# PIN del panel de banca (solo gate de UI, NO es seguridad real).
VITE_ADMIN_PIN=1234

# Intervalo entre sorteos en milisegundos (default 600000 = 10 min).
VITE_DRAW_INTERVAL_MS=600000

# Segundos antes del sorteo en que cierran las apuestas (default 60).
VITE_BET_CLOSE_SECONDS=60
